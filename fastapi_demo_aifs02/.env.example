# ⚠️ Copier ce fichier en `.env` et remplir. Le `.env` est ignoré par git.
# L'API tourne DANS Docker : "localhost" désignerait le conteneur lui-même.
# Pour atteindre le serveur MLflow qui tourne sur ta machine (port 4000) :
MLFLOW_TRACKING_URI=http://host.docker.internal:4000
# Si ton serveur MLflow est déployé (Hugging Face / EC2), mets son URL publique :
# MLFLOW_TRACKING_URI=https://<ton-space>.hf.space

# Nécessaire : le serveur MLflow renvoie un chemin s3:// et c'est l'API
# qui télécharge elle-même les artefacts du modèle depuis S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
