# ⚠️ Copier ce fichier en `.env` et remplir. Le `.env` est ignoré par git.
# Utilisé par : le conteneur du serveur MLflow (--env-file) ET le notebook train_dev.ipynb (load_dotenv).
# Le notebook tourne sur la machine hôte → localhost suffit.
MLFLOW_TRACKING_URI=http://localhost:4000
PORT=4000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ARTIFACT_ROOT=s3://<ton-bucket>/mlflow-artifacts/
BACKEND_STORE_URI=postgresql://<user>:<password>@<host>/<db>?sslmode=require
